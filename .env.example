# ---- Deployment mode ----
# "self_hosted" (default): billing disabled (all features unlocked),
#   backlink network disabled (it needs many tenants in one database).
# "cloud": the commercial hosted instance — enables Stripe billing and
#   the cross-account backlink network. Requires the Stripe block below.
NEXT_PUBLIC_DEPLOYMENT_MODE=self_hosted

# Public URL of the hosted Seedsy cloud (used in attribution links and
# "cloud-only feature" pointers). Leave the default unless you run your own cloud.
NEXT_PUBLIC_CLOUD_URL=https://seedsy.example.com

# Self-hosted only: set to "false" to remove the "Published with Seedsy" line
# from published articles. Leaving it on supports the project.
SEEDSY_ATTRIBUTION=true

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenRouter (https://openrouter.ai/keys) - one key for GPT, Claude, Gemini, Perplexity ----
OPENROUTER_API_KEY=sk-or-...

# Optional model overrides (OpenRouter model IDs)
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_WRITER_MODEL=anthropic/claude-sonnet-4

# Protects cron endpoints. Set the same value in Vercel env vars.
CRON_SECRET=generate-a-long-random-string

# Encrypts CMS credentials at rest (AES-256-GCM). Any long random string.
# Optional for single-operator self-hosts; REQUIRED before taking other
# people's CMS credentials (i.e. on the cloud). Don't rotate casually —
# integrations saved under an old key can't be decrypted with a new one.
CREDENTIALS_ENCRYPTION_KEY=generate-another-long-random-string

# Your deployed URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (cloud mode only — not needed for self-hosting) ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # a recurring monthly Price for the Pro plan
